# Form submissions are POSTed here as JSON: {"name": "...", "email": "...", "time": "ISO date"}
# Point this at a Google Apps Script web app URL that appends rows to a Sheet.
SUBMIT_WEBHOOK_URL=

# Supabase project (alpha_recruitment) — submissions are inserted into public.applications.
# Server-only (no NEXT_PUBLIC_ prefix); the publishable key can only insert, RLS blocks reads.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Resend — "you're on the list" confirmation email sent to applicants after a
# successful submission. Without RESEND_API_KEY the email is skipped (the
# submission itself still succeeds). Get a key at https://resend.com/api-keys.
RESEND_API_KEY=
# Sender shown to applicants. Must be on a domain verified in Resend (currently
# joinbuilders.org); when unset the code falls back to the onboarding@resend.dev
# sandbox, which only delivers to the Resend account's own inbox (fine for
# testing, useless in production).
RESEND_FROM="BUILDERS <hello@joinbuilders.org>"

# Signing secret for the Resend webhook that POSTs delivery failures (bounces,
# spam complaints, ...) to /api/webhooks/resend, where they're recorded in
# Supabase (public.email_errors). Resend dashboard → Webhooks.
RESEND_WEBHOOK_SECRET=
