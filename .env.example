# Form submissions are POSTed here as JSON: {"name": "...", "email": "...", "time": "ISO date"}
# Point this at a Google Apps Script web app URL that appends rows to a Sheet.
SUBMIT_WEBHOOK_URL=

# Supabase project (alpha_recruitment) — submissions are inserted into public.applications.
# Server-only (no NEXT_PUBLIC_ prefix); the publishable key can only insert, RLS blocks reads.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
